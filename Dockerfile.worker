FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# System deps required by heavy ML and document parsing packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libgomp1 \
    libmagic1 \
    poppler-utils \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    pkg-config \
    git \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.base.txt requirements.worker.txt ./

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.base.txt -r requirements.worker.txt

COPY src/ ./src

CMD ["celery", "-A", "src.infrastructure.tasks.celery_app:celery_app", "worker", "--loglevel=info"]
